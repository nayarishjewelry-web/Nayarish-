rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedAdmin() {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == 'nayarishjewelry@gmail.com';
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isAuthorizedAdmin() && isValidId(productId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isAuthorizedAdmin() && isValidId(categoryId);
    }

    // Maison Branding & Settings (Read accessible to public storefront, write restricted to authorized admin)
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAuthorizedAdmin() && isValidId(settingId);
    }

    // Purchase Orders
    match /orders/{orderId} {
      allow create: if isValidId(orderId) 
        && request.resource.data.customerName is string
        && request.resource.data.total is number;
      allow read, update, delete: if isValidId(orderId);
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
